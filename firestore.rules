rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isPositiveInt(value) {
      return value is int && value > 0;
    }

    function paymentSentTransitionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sentAt', 'sentVia'])
        && resource.data.status == 'paid'
        && request.resource.data.status == 'sent'
        && request.resource.data.sentVia == 'wa_me'
        && request.resource.data.sentAt is timestamp;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meta/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /summaries/{monthId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /branches/{branchId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.name);
        allow delete: if isOwner(uid);

        match /batches/{batchId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && isNonEmptyString(request.resource.data.name)
            && isPositiveInt(request.resource.data.defaultFee);
          allow delete: if isOwner(uid);

          match /students/{studentId} {
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && isNonEmptyString(request.resource.data.fullName)
              && isNonEmptyString(request.resource.data.whatsappNumber)
              && isPositiveInt(request.resource.data.monthlyFee);
            allow delete: if isOwner(uid);
          }

          match /payments/{paymentId} {
            allow read: if isOwner(uid);
            allow create, delete: if false;
            allow update: if isOwner(uid) && paymentSentTransitionOnly();
          }
        }
      }
    }
  }
}
