rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isPositiveInt(value) {
      return value is int && value > 0;
    }

    function isValidMonth(value) {
      return value is string
        && value.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function isValidPaymentMode(value) {
      return value in ['cash', 'upi', 'bank', 'other'];
    }

    function paymentSentTransitionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sentAt', 'sentVia'])
        && resource.data.status == 'paid'
        && request.resource.data.status == 'sent'
        && request.resource.data.sentVia in ['wa_me', 'share']
        && request.resource.data.sentAt is timestamp;
    }

    function paymentVoidTransitionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['voided', 'status'])
        && resource.data.voided == false
        && request.resource.data.voided == true
        && request.resource.data.status == 'voided';
    }

    function paymentCreateValid(uid) {
      let data = request.resource.data;
      return data.ownerId == uid
        && data.branchId is string
        && data.batchId is string
        && data.studentId is string
        && isNonEmptyString(data.studentName)
        && isNonEmptyString(data.whatsappNumber)
        && isValidMonth(data.month)
        && isPositiveInt(data.amount)
        && isPositiveInt(data.batchFee)
        && isValidPaymentMode(data.mode)
        && data.paidOn is timestamp
        && data.status == 'paid'
        && data.voided == false
        && isNonEmptyString(data.receiptNo)
        && data.receiptPath == ''
        && data.receiptUrl == ''
        && data.sentAt == null
        && data.sentVia == null
        && data.createdAt is timestamp;
    }

    function counterIncrementValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['receiptSeq'])
        && request.resource.data.receiptSeq == resource.data.receiptSeq + 1;
    }

    function counterCreateValid() {
      return request.resource.data.keys().hasOnly(['receiptSeq'])
        && request.resource.data.receiptSeq == 1;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meta/counters {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && counterCreateValid();
        allow update: if isOwner(uid) && counterIncrementValid();
        allow delete: if false;
      }

      match /summaries/{monthId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /branches/{branchId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.name);
        allow delete: if isOwner(uid);

        match /batches/{batchId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && isNonEmptyString(request.resource.data.name)
            && isPositiveInt(request.resource.data.defaultFee);
          allow delete: if isOwner(uid);

          match /students/{studentId} {
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && isNonEmptyString(request.resource.data.fullName)
              && isNonEmptyString(request.resource.data.whatsappNumber)
              && isPositiveInt(request.resource.data.monthlyFee);
            allow delete: if isOwner(uid);
          }

          match /payments/{paymentId} {
            allow read: if isOwner(uid);
            allow create: if isOwner(uid) && paymentCreateValid(uid);
            allow delete: if false;
            allow update: if isOwner(uid)
              && (paymentSentTransitionOnly() || paymentVoidTransitionOnly());
          }
        }
      }
    }
  }
}
